generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MEMBER
  ADMIN
  TREASURER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipPaymentStatus {
  PENDING
  PAID
  FAILED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketType {
  MEMBER
  NON_MEMBER
}

enum TicketStatus {
  PENDING
  PAID
  USED
  CANCELLED
  EXPIRED
}

enum AnnouncementAudience {
  PUBLIC
  MEMBERS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum InitiativeType {
  FUNDRAISER
  GENERAL
}

enum InitiativeStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

enum PaymentPurpose {
  MEMBERSHIP
  TICKET
  ORDER
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum PaymentReferenceType {
  MEMBERSHIP
  TICKET
  ORDER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MEMBERSHIP
  EVENT_TICKET
  MERCHANDISE
  FUNDRAISER
  EVENT_COST
  SUPPLIES
  REIMBURSEMENT
  OTHER
}

enum TransactionReferenceType {
  MEMBERSHIP
  TICKET
  ORDER
  INITIATIVE
  EXPENSE
  MANUAL
}

enum TransactionStatus {
  POSTED
  VOID
}

enum NotificationType {
  MEMBERSHIP
  EVENT
  TICKET
  ORDER
  ANNOUNCEMENT
  TASK
  EXPENSE
}

model User {
  id                       String     @id @default(cuid())
  name                     String
  email                    String     @unique
  passwordHash             String     @map("password_hash")
  role                     UserRole   @default(MEMBER)
  isVolunteer              Boolean    @default(false) @map("is_volunteer")
  phone                    String?
  studentId                String?    @map("student_id")
  profileImage             String?    @map("profile_image")
  status                   UserStatus @default(ACTIVE)
  notificationPreferences  Json       @default("{\"eventReminders\":true,\"membershipReminders\":true,\"orderUpdates\":true,\"announcementAlerts\":true,\"taskNotifications\":true,\"financeNotifications\":true}") @map("notification_preferences")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  memberships         Membership[]
  tickets             Ticket[]
  orders              Order[]
  assignedTasks       Task[]         @relation("TaskAssignee")
  expensesSubmitted   Expense[]      @relation("ExpenseSubmitter")
  expensesApproved    Expense[]      @relation("ExpenseApprover")
  payments            Payment[]
  transactions        Transaction[]
  notifications       Notification[]
  eventsCreated       Event[]        @relation("EventCreator")
  announcements       Announcement[]
  attendanceRecords   Attendance[]   @relation("AttendanceMember")
  attendanceChecked   Attendance[]   @relation("AttendanceStaff")
  initiativesCreated  Initiative[]

  @@index([role])
  @@index([studentId])
  @@map("users")
}

model MembershipPlan {
  id                     String   @id @default(cuid())
  name                   String
  fee                    Decimal  @db.Decimal(12, 2)
  durationMonths         Int      @map("duration_months")
  ticketDiscountPercent  Decimal  @default(0) @db.Decimal(5, 2) @map("ticket_discount_percent")
  merchDiscountPercent   Decimal  @default(0) @db.Decimal(5, 2) @map("merch_discount_percent")
  renewalReminderDays    Int      @map("renewal_reminder_days")
  gracePeriodDays        Int      @default(0) @map("grace_period_days")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  memberships            Membership[]

  @@map("membership_plans")
}

model Membership {
  id              String                   @id @default(cuid())
  userId          String                   @map("user_id")
  planId          String                   @map("plan_id")
  startDate       DateTime?                @map("start_date")
  endDate         DateTime?                @map("end_date")
  duesAmount      Decimal                  @db.Decimal(12, 2) @map("dues_amount")
  paymentId       String?                  @unique @map("payment_id")
  paymentStatus   MembershipPaymentStatus  @default(PENDING) @map("payment_status")
  status          MembershipStatus         @default(PENDING)
  reminderSentAt  DateTime?                @map("reminder_sent_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan    MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("memberships")
}

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime    @map("ends_at")
  venue           String
  capacity        Int
  memberPrice     Decimal     @db.Decimal(12, 2) @map("member_price")
  nonMemberPrice  Decimal     @db.Decimal(12, 2) @map("non_member_price")
  status          EventStatus @default(DRAFT)
  createdById     String      @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  createdBy  User         @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tickets    Ticket[]
  attendance Attendance[]

  @@index([status])
  @@index([startsAt])
  @@map("events")
}

model Ticket {
  id            String       @id @default(cuid())
  eventId       String       @map("event_id")
  userId        String       @map("user_id")
  paymentId     String?      @unique @map("payment_id")
  ticketType    TicketType   @map("ticket_type")
  price         Decimal      @db.Decimal(12, 2)
  qrToken       String?      @unique @map("qr_token")
  status        TicketStatus @default(PENDING)
  holdExpiresAt DateTime?    @map("hold_expires_at")
  checkedInAt   DateTime?    @map("checked_in_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attendance Attendance?

  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model Attendance {
  id           String   @id @default(cuid())
  ticketId     String   @unique @map("ticket_id")
  eventId      String   @map("event_id")
  userId       String   @map("user_id")
  checkedInAt  DateTime @map("checked_in_at")
  checkedInById String  @map("checked_in_by")

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user        User   @relation("AttendanceMember", fields: [userId], references: [id], onDelete: Restrict)
  checkedInBy User   @relation("AttendanceStaff", fields: [checkedInById], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@map("attendance")
}

model Announcement {
  id          String                 @id @default(cuid())
  title       String
  content     String
  createdById String                 @map("created_by")
  audience    AnnouncementAudience
  status      AnnouncementStatus     @default(DRAFT)
  publishedAt DateTime?              @map("published_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("announcements")
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  category    String
  price       Decimal       @db.Decimal(12, 2)
  imageUrl    String?       @map("image_url")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  variants    ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id                 String  @id @default(cuid())
  productId          String  @map("product_id")
  size               String
  stockQuantity      Int     @map("stock_quantity")
  lowStockThreshold  Int     @map("low_stock_threshold")
  sku                String? @unique

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  paymentId       String?            @unique @map("payment_id")
  totalAmount     Decimal            @db.Decimal(12, 2) @map("total_amount")
  discountAmount  Decimal            @default(0) @db.Decimal(12, 2) @map("discount_amount")
  paymentStatus   OrderPaymentStatus @default(PENDING) @map("payment_status")
  orderStatus     OrderStatus        @default(PENDING) @map("order_status")
  fulfillment     FulfillmentMethod
  holdExpiresAt   DateTime?          @map("hold_expires_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items   OrderItem[]

  @@index([userId])
  @@index([orderStatus])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String  @map("order_id")
  productVariantId String  @map("product_variant_id")
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2) @map("unit_price")
  subtotal         Decimal @db.Decimal(12, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Initiative {
  id          String           @id @default(cuid())
  name        String
  description String
  type        InitiativeType
  startDate   DateTime         @map("start_date")
  endDate     DateTime         @map("end_date")
  status      InitiativeStatus @default(PLANNED)
  createdById String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks     Task[]
  expenses  Expense[]

  @@map("initiatives")
}

model Task {
  id           String       @id @default(cuid())
  initiativeId String       @map("initiative_id")
  assignedToId String?      @map("assigned_to")
  title        String
  description  String
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?    @map("due_date")
  status       TaskStatus   @default(TODO)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  assignee   User?      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([initiativeId])
  @@index([assignedToId])
  @@map("tasks")
}

model Expense {
  id            String        @id @default(cuid())
  submittedById String        @map("submitted_by")
  initiativeId  String?       @map("initiative_id")
  category      String
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  receiptUrl    String?       @map("receipt_url")
  status        ExpenseStatus @default(PENDING)
  approvedById  String?       @map("approved_by")
  reviewedAt    DateTime?     @map("reviewed_at")
  reimbursedAt  DateTime?     @map("reimbursed_at")
  transactionId String?       @unique @map("transaction_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  submitter   User         @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  approver    User?        @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  initiative  Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([submittedById])
  @@index([status])
  @@map("expenses")
}

model Payment {
  id                 String               @id @default(cuid())
  userId             String               @map("user_id")
  purpose            PaymentPurpose
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @db.Char(3)
  status             PaymentStatus        @default(CREATED)
  razorpayOrderId    String               @unique @map("razorpay_order_id")
  razorpayPaymentId  String?              @unique @map("razorpay_payment_id")
  referenceType      PaymentReferenceType @map("reference_type")
  referenceId        String               @map("reference_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership  Membership?
  ticket      Ticket?
  order       Order?
  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model Transaction {
  id            String                   @id @default(cuid())
  userId        String?                  @map("user_id")
  paymentId     String?                  @map("payment_id")
  type          TransactionType
  category      TransactionCategory
  referenceType TransactionReferenceType @map("reference_type")
  referenceId   String                   @map("reference_id")
  amount        Decimal                  @db.Decimal(12, 2)
  currency      String                   @db.Char(3)
  description   String
  status        TransactionStatus        @default(POSTED)
  createdAt     DateTime                 @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  expense Expense?

  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@index([paymentId])
  @@index([referenceType, referenceId])
  @@map("transactions")
}

model Notification {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  title         String
  message       String
  type          NotificationType
  isRead        Boolean          @default(false) @map("is_read")
  referenceType String?          @map("reference_type")
  referenceId   String?          @map("reference_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model OrganizationSetting {
  id                        String   @id @default(cuid())
  organizationName          String   @map("organization_name")
  logoUrl                   String?  @map("logo_url")
  description               String   @default("")
  email                     String?
  phone                     String?
  address                   String?
  website                   String?
  socialLinks               Json     @default("[]") @map("social_links")
  currency                  String   @default("INR")
  timezone                  String   @default("Asia/Kolkata")
  dateFormat                String   @default("DD/MM/YYYY") @map("date_format")
  defaultEventCapacity      Int      @default(100) @map("default_event_capacity")
  defaultMemberPrice        Decimal  @default(0) @db.Decimal(12, 2) @map("default_member_price")
  defaultNonMemberPrice     Decimal  @default(0) @db.Decimal(12, 2) @map("default_non_member_price")
  defaultLowStockThreshold  Int      @default(5) @map("default_low_stock_threshold")
  paymentHoldMinutes        Int      @default(15) @map("payment_hold_minutes")
  pickupEnabled             Boolean  @default(true) @map("pickup_enabled")
  deliveryEnabled           Boolean  @default(false) @map("delivery_enabled")
  notificationDefaults      Json     @map("notification_defaults")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
}
