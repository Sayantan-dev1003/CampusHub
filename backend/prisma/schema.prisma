// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
  TREASURER
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  PENDING
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  BOOKED
  CHECKED_IN
  CANCELLED
  REFUNDED
}

enum TicketType {
  MEMBER
  NON_MEMBER
  VIP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  MEMBERSHIP_DUES
  TICKET_SALE
  MERCHANDISE_SALE
  FUNDRAISING_INCOME
  EXPENSE
  REIMBURSEMENT
  OTHER
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

// ─────────────────────────────────────────────
// USER / AUTH
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  member         Member?
  announcements  Announcement[]
  tasks          VolunteerTask[]
  expenses       Expense[]
  transactions   Transaction[]

  @@map("users")
}

// ─────────────────────────────────────────────
// MEMBERSHIP
// ─────────────────────────────────────────────

model Member {
  id             String           @id @default(cuid())
  userId         String           @unique
  studentId      String           @unique
  firstName      String
  lastName       String
  phone          String?
  profilePhoto   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  tickets        Ticket[]
  orders         Order[]
  volunteerTasks VolunteerTask[]
  expenses       Expense[]

  @@map("members")
}

model Membership {
  id             String           @id @default(cuid())
  memberId       String
  membershipType String           @default("Standard")
  status         MembershipStatus @default(PENDING)
  duesAmount     Float
  paymentStatus  PaymentStatus    @default(PENDING)
  startDate      DateTime
  expiryDate     DateTime
  benefits       String[]
  renewalReminderSent Boolean     @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  member         Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transaction    Transaction?

  @@map("memberships")
}

// ─────────────────────────────────────────────
// EVENTS & TICKETING
// ─────────────────────────────────────────────

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String?
  venue           String
  startDate       DateTime
  endDate         DateTime
  totalCapacity   Int
  remainingSeats  Int
  status          EventStatus @default(DRAFT)
  memberPrice     Float
  nonMemberPrice  Float
  coverImage      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  tickets         Ticket[]

  @@map("events")
}

model Ticket {
  id             String       @id @default(cuid())
  eventId        String
  memberId       String?
  buyerName      String?
  buyerEmail     String?
  ticketType     TicketType
  price          Float
  status         TicketStatus @default(BOOKED)
  qrCode         String?      @unique
  checkInAt      DateTime?
  checkedInBy    String?
  purchasedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member         Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  transaction    Transaction?

  @@map("tickets")
}

// ─────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorId    String
  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

// ─────────────────────────────────────────────
// MERCHANDISE & INVENTORY
// ─────────────────────────────────────────────

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  category    String
  price       Float
  memberPrice Float?
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  variants    ProductVariant[]
  orderItems  OrderItem[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

model Order {
  id            String       @id @default(cuid())
  memberId      String
  status        OrderStatus  @default(PENDING)
  totalAmount   Float
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  transaction   Transaction?

  @@map("orders")
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  unitPrice Float
  subtotal  Float

  // Relations
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// ─────────────────────────────────────────────
// VOLUNTEER & TASKS
// ─────────────────────────────────────────────

model Initiative {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tasks       VolunteerTask[]

  @@map("initiatives")
}

model VolunteerTask {
  id            String     @id @default(cuid())
  initiativeId  String
  title         String
  description   String?
  assignedToId  String?
  assignedById  String
  dueDate       DateTime?
  status        TaskStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  initiative    Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  assignedTo    Member?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy    User       @relation(fields: [assignedById], references: [id])

  @@map("volunteer_tasks")
}

// ─────────────────────────────────────────────
// FINANCE & EXPENSES
// ─────────────────────────────────────────────

model Transaction {
  id            String               @id @default(cuid())
  type          TransactionType
  direction     TransactionDirection
  amount        Float
  description   String?
  reference     String?
  createdById   String
  membershipId  String?              @unique
  ticketId      String?              @unique
  orderId       String?              @unique
  expenseId     String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relations
  createdBy    User        @relation(fields: [createdById], references: [id])
  membership   Membership? @relation(fields: [membershipId], references: [id])
  ticket       Ticket?     @relation(fields: [ticketId], references: [id])
  order        Order?      @relation(fields: [orderId], references: [id])
  expense      Expense?    @relation(fields: [expenseId], references: [id])

  @@map("transactions")
}

model Expense {
  id            String        @id @default(cuid())
  memberId      String
  submittedById String
  amount        Float
  category      String
  description   String
  receiptUrl    String?
  status        ExpenseStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  reimbursedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  submittedBy   User          @relation(fields: [submittedById], references: [id])
  transaction   Transaction?

  @@map("expenses")
}
